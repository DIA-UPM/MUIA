{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "image.schema.json",
  "title": "Image",
  "type": "object",
  "required": ["src"],
  "properties": {
    "src": { "type": "string", "pattern": "^/" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "alt": { "type": "string" },
    "srcset": { "type": "string" },
    "sizes": { "type": "string" }
  },
  "additionalProperties": false
}
