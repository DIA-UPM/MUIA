{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blocks.schema.json",
  "title": "Content blocks",
  "description": "A list of content blocks. Essential Blocks blocks keep the id their CSS is keyed on.",
  "type": "array",
  "items": { "$ref": "#/definitions/block" },
  "definitions": {
    "ebId": { "type": "string", "pattern": "^eb-[a-z-]+-[a-z0-9]{4,8}$" },
    "link": {
      "type": "object",
      "required": ["href"],
      "properties": {
        "href": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "rel": { "type": "string" },
        "overlay": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["html", "wrapper", "row", "column", "advanced-heading", "infobox", "accordion", "advanced-tabs", "button", "dual-button", "feature-list", "number-counter", "advanced-image", "advanced-video", "advanced-navigation", "post-grid"]
        },
        "id": { "$ref": "#/definitions/ebId" },
        "align": { "enum": ["full", "wide"] },
        "className": { "type": "string" },
        "anchor": { "type": "string", "pattern": "^\\S+$" },
        "animation": { "type": "string" },
        "rootClass": { "type": "boolean" },
        "rootFirst": { "type": "boolean" },
        "outer": { "type": "boolean" },
        "legacy": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "html" } } },
          "then": { "required": ["html"], "properties": { "html": { "type": "string" } } },
          "else": { "required": ["id"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["wrapper", "row", "column"] } } },
          "then": { "required": ["children"], "properties": { "children": { "$ref": "#" }, "contentAlign": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "advanced-heading" } } },
          "then": {
            "required": ["parts"],
            "properties": {
              "preset": { "type": "string" },
              "parts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["part"],
                  "properties": {
                    "part": { "enum": ["title", "subtitle", "separator"] },
                    "tag": { "type": "string", "pattern": "^(h[1-6]|p|div|span)$" },
                    "html": { "type": "string" },
                    "style": { "type": "string" },
                    "icon": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "accordion" } } },
          "then": {
            "required": ["items", "mode", "tabIcon", "expandedIcon"],
            "properties": {
              "mode": { "enum": ["accordion", "toggle"] },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "children"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string", "minLength": 1 },
                    "titleTag": { "type": "string" },
                    "clickable": { "type": "string" },
                    "noBlockClass": { "type": "boolean" },
                    "children": { "$ref": "#" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "advanced-tabs" } } },
          "then": {
            "required": ["tabs"],
            "properties": {
              "tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["tabId", "title", "children"],
                  "properties": {
                    "tabId": { "type": "string" },
                    "title": { "type": "string" },
                    "customId": { "type": "string" },
                    "anchor": { "type": "string" },
                    "icon": { "type": "string" },
                    "children": { "$ref": "#" }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "button" } } },
          "then": { "required": ["href", "text"], "properties": { "href": { "type": "string", "minLength": 1 }, "text": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "dual-button" } } },
          "then": { "required": ["buttons"], "properties": { "buttons": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "required": ["text", "href"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "feature-list" } } },
          "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["icon", "title"] } } } }
        },
        {
          "if": { "properties": { "type": { "const": "number-counter" } } },
          "then": { "required": ["title", "target"], "properties": { "target": { "type": "string", "pattern": "^-?[0-9.]+$" } } }
        },
        {
          "if": { "properties": { "type": { "const": "advanced-image" } } },
          "then": { "required": ["src"], "properties": { "src": { "type": "string", "minLength": 1 }, "alt": { "type": "string" }, "link": { "$ref": "#/definitions/link" } } }
        },
        {
          "if": { "properties": { "type": { "const": "advanced-video" } } },
          "then": { "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" } } }
        },
        {
          "if": { "properties": { "type": { "const": "infobox" } } },
          "then": { "properties": { "image": { "type": "object", "required": ["src"] }, "link": { "$ref": "#/definitions/link" } } }
        },
        {
          "if": { "properties": { "type": { "const": "post-grid" } } },
          "then": {
            "required": ["source", "orderBy", "order", "perPage", "preset"],
            "properties": {
              "source": { "enum": ["news", "people"] },
              "tags": { "type": "array", "items": { "type": "string" } },
              "categories": { "type": "array", "items": { "type": "string" } },
              "orderBy": { "enum": ["date", "title"] },
              "order": { "enum": ["asc", "desc"] },
              "perPage": { "type": "integer", "minimum": 1 },
              "pagination": { "type": "boolean" }
            }
          }
        }
      ]
    }
  }
}
