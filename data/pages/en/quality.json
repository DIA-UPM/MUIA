              "children": [
                {
                  "type": "html",
                  "html": "<h2 class=\"wp-block-heading has-ast-global-color-5-color has-text-color has-link-color wp-elements-f4effab3667fca6cfca650d08c941113\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30);padding-top:0;padding-bottom:0\">Ensuring Excellence</h2>"
                },
                {
                  "type": "advanced-heading",
                  "id": "eb-advance-heading-i12rphw",
                  "rootClass": false,
                  "preset": "button-1",
                  "parts": [
                    {
                      "part": "title",
                      "tag": "h2",
                      "html": "Quality &amp; Accreditation"
                    },
                    {
                      "part": "subtitle",
                      "tag": "p",
                      "html": "The Master’s Degree in Artificial Intelligence of the ETS in Computer Engineering of the UPM stands out for its rigorous commitment to academic excellence, backed by Institutional Accreditation and the distinctive EURO-INF seal. This seal is synonymous with quality and competence in the educational and professional field, guaranteeing that our programmes meet the highest international standards. We aim to inspire and train the next generation of leaders in the field of artificial intelligence, offering them an education that is not only globally recognised but also opens doors to career opportunities around the world."
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "outer": false,
              "id": "eb-column-0o85v7r",
              "children": []
            }
          ]
        }
      ]
    },
